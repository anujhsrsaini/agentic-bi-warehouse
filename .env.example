# Sarvam Token Factory (OpenAI-compatible /v2/chat/completions)
SARVAM_API_KEY=
# Optional overrides (AGENTIC_BI_ prefix also supported via pydantic settings)
AGENTIC_BI_ENGINE=langgraph
AGENTIC_BI_LLM_PROVIDER=sarvam
AGENTIC_BI_LLM_BASE_URL=https://api.sarvam.ai/v2
AGENTIC_BI_LLM_MODEL=sarvam-105b
AGENTIC_BI_LLM_MODEL_ROUTER=sarvam-105b
AGENTIC_BI_LLM_MODEL_GROUNDER=sarvam-105b
AGENTIC_BI_LLM_MODEL_SQL=glm5.3-flash
AGENTIC_BI_LLM_MODEL_REPAIR=sarvam-105b
AGENTIC_BI_LLM_MODEL_NARRATIVE=glm5.3-flash
AGENTIC_BI_LLM_TEMPERATURE=0.0
AGENTIC_BI_LLM_TIMEOUT_S=60
AGENTIC_BI_LLM_MAX_RETRIES=2
AGENTIC_BI_LLM_MAX_TOKENS=2048
AGENTIC_BI_LLM_REASONING_EFFORT=low
